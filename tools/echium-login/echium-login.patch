+// 沿用原APN加载与有界等待逻辑，仅把插件身份作为参数传入。
+find_or_load_plugin :: proc(name: cstring16, location: string) -> (scan.Module_Info, bool) {
+    for _ in 0..<MAX_RETRIES_BEFORE_SELF_LOAD {
+        if m, ok := scan.module_info_from_name(name); ok {
+            log.debugf("游戏已加载插件：%s", name)
+            return m, true
+        }
+        log.debugf("等待插件加载，100ms后重试：%s", name)
+        time.sleep(100 * time.Millisecond)
+    }
+
+    if _, lok := dynlib.load_library(location); lok {
+        if m, sok := scan.module_info_from_name(name); sok {
+            log.debugf("通过原加载入口载入插件：%s", name)
+            return m, true
+        }
+    }
+
+    return {}, false
+}
