diff --git a/patches/sdk_native.odin b/patches/sdk_native.odin
new file mode 100644
index 0000000..b73d862
--- /dev/null
+++ b/patches/sdk_native.odin
@@ -0,0 +1,92 @@
+package patches
+
+import "base:runtime"
+import "core:log"
+import "core:strings"
+import "shared:il2cure/e9c2da9/hook"
+import "shared:il2cure/e9c2da9/scan"
+import "../cfg"
+
+orig_hoyo_network_alloc: Apn_Alloc_Proc
+orig_sdk_fallback_alloc: Apn_Alloc_Proc
+
+sdk_native_host_allowed :: proc(host: string) -> bool {
+	domains := []string {"hoyoverse.com", "mihoyo.com", "bhsr.com", "starrails.com"}
+	for domain in domains {
+		if strings.equal_fold(host, domain) {
+			return true
+		}
+		if len(host) > len(domain) && host[len(host)-len(domain)-1] == '.' &&
+		   strings.equal_fold(host[len(host)-len(domain):], domain) {
+			return true
+		}
+	}
+	return false
+}
+
+// 只替换服务域名的authority，保留路径、查询和片段的原始字节。
+sdk_native_target :: proc (url: string) -> (target: string, allocated: bool) {
+	if !cfg.cfg.redirect_http { return url, false }
+	start := 0
+	if len(url) >= 8 && strings.equal_fold(url[:8], "https://") { start = 8 }
+	else if len(url) >= 7 && strings.equal_fold(url[:7], "http://") { start = 7 }
+	else { return url, false }
+	end := len(url)
+	for i in start..<len(url) {
+		if url[i] == '/' || url[i] == '?' || url[i] == '#' { end = i; break }
+	}
+	host := url[start:end]
+	if strings.contains(host, "@") { return url, false }
+	if colon := strings.index(host, ":"); colon >= 0 { host = host[:colon] }
+	if !sdk_native_host_allowed(host) {
+		return url, false
+	}
+	if end == len(url) { return cfg.cfg.sdk_url, false }
+	return strings.concatenate({cfg.cfg.sdk_url, url[end:]}, context.temp_allocator), true
+}
+
+// 复用原字符串赋值接口；目标函数会在返回前复制字节，不保留临时指针。
+sdk_native_assign :: proc (original: Apn_Alloc_Proc, source: string, rcx, rdx, r8, r9: rawptr) -> rawptr {
+	if rdx != nil {
+		value := string((cast([^]u8)(rdx))[:int(uintptr(r8))])
+		log_url_metadata(source, value)
+		url, allocated := sdk_native_target(value)
+		if allocated { defer delete(url, context.temp_allocator) }
+		if url != value {
+			log.infof("SDK_URL_ASSIGN_REDIRECT source=%s", source)
+			return original(rcx, raw_data(url), rawptr(uintptr(len(url))), r9)
+		}
+	}
+	return original(rcx, rdx, r8, r9)
+}
+
+patched_hoyo_network_alloc :: proc "c" (rcx, rdx, r8, r9: rawptr) -> rawptr {
+	context = runtime.default_context()
+	context.logger = detour_logger
+	return sdk_native_assign(orig_hoyo_network_alloc, "HOYO_NATIVE", rcx, rdx, r8, r9)
+}
+
+patched_sdk_fallback_alloc :: proc "c" (rcx, rdx, r8, r9: rawptr) -> rawptr {
+	context = runtime.default_context()
+	context.logger = detour_logger
+	return sdk_native_assign(orig_sdk_fallback_alloc, "SDK_FALLBACK", rcx, rdx, r8, r9)
+}
+
+install_sdk_string_alloc :: proc (module: scan.Module_Info, pattern: []u16, replacement: rawptr, original: ^Apn_Alloc_Proc, source: string) -> bool {
+	if !cfg.cfg.redirect_http { return false }
+	target := resolve_target(module, pattern)
+	if target == 0 { log.errorf("SDK_URL_ASSIGN_PATTERN_MISSING source=%s", source); return false }
+	tramp, ok := hook.hook_inline_address(target, replacement)
+	if !ok { log.errorf("SDK_URL_ASSIGN_HOOK_FAILED source=%s", source); return false }
+	original^ = cast(Apn_Alloc_Proc)tramp
+	log.infof("SDK_URL_ASSIGN_READY source=%s", source)
+	return true
+}
+
+install_hoyo_network_alloc :: proc (module: scan.Module_Info) -> bool {
+	return install_sdk_string_alloc(module, cfg.cfg.hoyo_network_alloc_pat, rawptr(patched_hoyo_network_alloc), &orig_hoyo_network_alloc, "HOYO_NATIVE")
+}
+
+install_sdk_fallback_alloc :: proc (module: scan.Module_Info) -> bool {
+	return install_sdk_string_alloc(module, cfg.cfg.sdk_fallback_alloc_pat, rawptr(patched_sdk_fallback_alloc), &orig_sdk_fallback_alloc, "SDK_FALLBACK")
+}
diff --git a/patches/url_meta.odin b/patches/url_meta.odin
new file mode 100644
index 0000000..4ba7de6
--- /dev/null
+++ b/patches/url_meta.odin
@@ -0,0 +1,36 @@
+package patches
+
+import "core:log"
+import "core:strings"
+
+// 仅记录URL来源、scheme和主机；不记录路径、查询、片段或用户信息。
+log_url_metadata :: proc (source, url: string) {
+
+	scheme_len := 0
+	if strings.has_prefix(url, "https://") {
+		scheme_len = 5
+	} else if strings.has_prefix(url, "http://") {
+		scheme_len = 4
+	} else {
+		return
+	}
+	rest := url[scheme_len + 3:]
+	end := len(rest)
+	for i in 0..<len(rest) {
+		if rest[i] == '/' || rest[i] == '?' || rest[i] == '#' {
+			end = i
+			break
+		}
+	}
+	host := rest[:end]
+	safe := len(host) > 0
+	for ch in host {
+		if !((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+		     (ch >= '0' && ch <= '9') || ch == '.' || ch == '-' || ch == '_' ||
+		     ch == ':' || ch == '[' || ch == ']') {
+			safe = false
+		}
+	}
+	if !safe { host = "REDACTED" }
+	log.infof("SDK_URL_META source=%s scheme=%s host=%s", source, url[:scheme_len], host)
+}
