@@ -6,0 +7 @@ import "shared:il2cure/e9c2da9/hook"
+import "shared:il2cure/e9c2da9/scan"
@@ -17,0 +19,14 @@ orig_apn_alloc: Apn_Alloc_Proc
+Apn_Endpoint_Lookup_Proc :: #type proc "c" (
+	rcx: rawptr,
+	rdx: rawptr,
+	r8:  rawptr,
+) -> rawptr
+
+Apn_Std_String :: struct {
+	storage:  [16]u8,
+	size:     uintptr,
+	capacity: uintptr,
+}
+
+orig_apn_endpoint_lookup: Apn_Endpoint_Lookup_Proc
+
@@ -36,0 +52,54 @@ install_apn_alloc :: proc () -> bool {
+install_apn_endpoint_lookup :: proc () -> bool {
+	target, ok := scan.find_pattern_in_module(apn, cfg.cfg.apn_endpoint_lookup_pat)
+	if !ok {
+		log.error("apn endpoint lookup pattern not found. install failed.")
+		return false
+	}
+
+	tramp, hok := hook.hook_inline_address(target, rawptr(patched_apn_endpoint_lookup))
+	if !hok {
+		log.error("apn endpoint lookup inline hook not ok. install failed.")
+		return false
+	}
+
+	orig_apn_endpoint_lookup = cast(Apn_Endpoint_Lookup_Proc)tramp
+	log.info("APN_ENDPOINT_LOOKUP_READY")
+	return true
+}
+
+apn_std_string_view :: proc (value: rawptr) -> (string, bool) {
+	if value == nil { return "", false }
+	object := cast(^Apn_Std_String)(value)
+	if object.size == 0 { return "", true }
+	if object.size > object.capacity || object.size > 16 * 1024 { return "", false }
+
+	data := rawptr(&object.storage[0])
+	if object.capacity >= 16 {
+		data = (cast(^rawptr)(value))^
+	}
+	if data == nil { return "", false }
+	return string((cast([^]u8)(data))[:int(object.size)]), true
+}
+
+apn_rewrite_endpoint :: proc (output: rawptr, value: string) -> bool {
+	target, allocated := sdk_native_target(value)
+	if allocated { defer delete(target, context.temp_allocator) }
+	if target == value { return false }
+	orig_apn_alloc(output, raw_data(target), rawptr(uintptr(len(target))), nil)
+	return true
+}
+
+patched_apn_endpoint_lookup :: proc "c" (rcx, rdx, r8: rawptr) -> rawptr {
+	context = runtime.default_context()
+	context.logger = detour_logger
+
+	result := orig_apn_endpoint_lookup(rcx, rdx, r8)
+	if value, ok := apn_std_string_view(result); ok {
+		log_url_metadata("APN_ENDPOINT", value)
+		if apn_rewrite_endpoint(result, value) {
+			log.info("APN_ENDPOINT_REDIRECT")
+		}
+	}
+	return result
+}
+
