@@ -0,0 +1,36 @@
+package patches
+
+import "core:log"
+import "core:strings"
+
+// 仅记录URL来源、scheme和主机；不记录路径、查询、片段或用户信息。
+log_url_metadata :: proc (source, url: string) {
+
+	scheme_len := 0
+	if strings.has_prefix(url, "https://") {
+		scheme_len = 5
+	} else if strings.has_prefix(url, "http://") {
+		scheme_len = 4
+	} else {
+		return
+	}
+	rest := url[scheme_len + 3:]
+	end := len(rest)
+	for i in 0..<len(rest) {
+		if rest[i] == '/' || rest[i] == '?' || rest[i] == '#' {
+			end = i
+			break
+		}
+	}
+	host := rest[:end]
+	safe := len(host) > 0
+	for ch in host {
+		if !((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+		     (ch >= '0' && ch <= '9') || ch == '.' || ch == '-' || ch == '_' ||
+		     ch == ':' || ch == '[' || ch == ']') {
+			safe = false
+		}
+	}
+	if !safe { host = "REDACTED" }
+	log.infof("SDK_URL_META source=%s scheme=%s host=%s", source, url[:scheme_len], host)
+}
